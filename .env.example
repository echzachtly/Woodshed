# Copy to `.env.local` for local development. Never commit real values.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Supabase (Phase 3+) — browser-safe keys only with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — use in Route Handlers / Server Actions only, never in client bundles.
# Set in Vercel "Environment Variables" for Production + Preview; omit locally until needed.
SUPABASE_SERVICE_ROLE_KEY=
