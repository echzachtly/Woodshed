## Data Model

```ts
type MediaSourceKind = "upload" | "youtube";

type TimelinePeakSource = "real" | "synthetic";

type TimelinePeakData = {
  source: TimelinePeakSource;
  duration: number;
  samplesPerSecond?: number;
  peaks: number[];
};

type UnifiedTimelineRegion = {
  id: string;
  type: "practice-section" | "focus-loop";
  start: number;
  end: number;
  parentId?: string;
  label?: string;
  color?: string;
  isSelected?: boolean;
};

type UnifiedTimelineMode = "practice" | "edit";

type UnifiedTimelineProps = {
  mediaSourceKind: MediaSourceKind;
  duration: number;
  currentTime: number;
  isPlaying: boolean;
  mode: UnifiedTimelineMode;
  peaks: TimelinePeakData;
  regions: UnifiedTimelineRegion[];
  selectedRegionId?: string;
  zoomLevel: number;
  onSeek: (time: number) => void;
  onRegionSelect: (regionId: string) => void;
  onRegionCreate: (region: Omit<UnifiedTimelineRegion, "id">) => void;
  onRegionUpdate: (regionId: string, patch: Partial<UnifiedTimelineRegion>) => void;
  onModeChange?: (mode: UnifiedTimelineMode) => void;
};